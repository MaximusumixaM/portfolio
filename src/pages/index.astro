---
import exposeGif from "../assets/images/about/expose.gif";
import { HeroExperience } from "../components/app/max-hero/HeroExperience";
import { projects } from "../data/projects";
import { resolveProjects } from "../data/resolve-project-images";
import { bio, awards, socialLinks } from "../data/site";
import Layout from "../layouts/Layout.astro";

const resolvedProjects = await resolveProjects(projects);
const about = {
  bio,
  awards,
  socialLinks: socialLinks.map((link) => ({
    label: link.label,
    href: link.href,
    iconSrc: link.icon.src,
  })),
  photoSrc: exposeGif.src,
};
---

<Layout>
  <HeroExperience client:load projects={resolvedProjects} about={about} />
</Layout>
