---
import { SiteExperience } from "../../components/app/SiteExperience";
import { loadChapters } from "../../data/chapters";
import { loadExperience } from "../../data/experience";
import { loadProjects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";

const [chapters, projects, experience] = await Promise.all([
  loadChapters(),
  loadProjects(),
  loadExperience(),
]);
---

<Layout title="About - Max Nobell-Cluff">
  <!-- Before the page loads: a refresh's scroll restoration would otherwise land after the island
       has parked the portfolio at the hero's end, and undo it. -->
  <script is:inline slot="head">
    history.scrollRestoration = "manual";
  </script>
  <SiteExperience
    client:load
    chapters={chapters}
    projects={projects}
    experience={experience}
    initialView={{ kind: "about", section: "story" }}
  />
</Layout>
